{
  "name": "tochka-prototype-ui",
  "version": "1.1.3",
  "description": "UI-кит Точки для вайбкодинга и прототипирования",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.tochka-tech.com/design-community/ai-learning/design-system.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "cd demo && vite",
    "build": "rm -rf dist && vite build && tsc --emitDeclarationOnly --project tsconfig.json --outDir dist",
    "build:demo": "cd demo && vite build",
    "preview:demo": "cd demo && vite preview",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
}
