# Dependencies are never committed. The old entry named only
# prototype/design-system/node_modules, so prototype/my-prototype/node_modules
# slipped through and 2601 of its files ended up tracked — 67 MB of the repo.
# Restore any of them with `npm install`; the lockfiles are what is tracked.
node_modules/

# Figma exports are local snapshots of a cloud document — Figma itself is the
# source of truth (component CSS cites Figma node ids). The 17 MB .fig already
# in history was swept in by the broad `git add` in 35d885c, not tracked on
# purpose; keeping these out stops the repo growing by ~30 MB per re-export.
*.fig

# Сборка обоих приложений в один артефакт Pages (.github/workflows/deploy.yml)
_site/
